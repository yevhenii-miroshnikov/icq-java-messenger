<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" styleClass="root"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="org.example.messengerclient.controllers.LoginController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Login to Messenger" styleClass="header-label"/>

    <TextField fx:id="serverIpField" text="localhost" promptText="Server IP Address" styleClass="text-field" maxWidth="250.0"/>

    <HBox styleClass="input-group" maxWidth="250.0" alignment="CENTER_LEFT">
        <Label text="\@" styleClass="input-prefix"/>
        <TextField fx:id="loginField" promptText="Your username" styleClass="text-field-transparent" HBox.hgrow="ALWAYS"/>
    </HBox>

    <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="password-field" maxWidth="250.0"/>

    <Button text="Login" onAction="#onLoginButtonClick" styleClass="button" prefWidth="150.0" defaultButton="true"/>

    <Label fx:id="statusLabel" text="" styleClass="error-label"/>

    <Hyperlink text="Not registered yet? Create an account" onAction="#onRegisterLinkClick" styleClass="link-button"/>

</VBox>